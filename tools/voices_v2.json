[
{
"name": "wiz_fail3",
"text": "You fool. You didn't make it. Boom!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/cPw3ZyW2zTtPshxWSNIO/SQIHVar0QbRXg9yVpJBy/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=TGsp4FAVYJBjE15b_N7195cL1lE="
},
{
"name": "wiz_hellexit1",
"text": "Up you go. Do try harder next time.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/v93mtNaph6JuZ1gaKKt3/qr1rnqavlx828hVajoFs/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=0VADYba4_WOrfudKBUE---uvOUs="
},
{
"name": "wiz_hellexit2",
"text": "Out of the fire. You owe me one.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/TyAiUM8UFTcc4w3KsiBT/OMgCRB6yY8jd4QLNCb14/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=yCh2heQ8_QPuEe_tPWo4M8YtDps="
},
{
"name": "wiz_land1",
"text": "Back on earth. Show-off.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/abXxHPawo9PxQMczqn4g/Sq6nRvgXYLKji9mEFCMr/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=y0URZJh-fnw8Wq451-PveYHYnjY="
},
{
"name": "wiz_land2",
"text": "Welcome down. Try not to gloat.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/JOjPKp8InIPFIaJaOUMg/rHrBPTe1h8LL6tZTCbx6/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=YvoznGLKgpx4lG7-mJzvjNoWD0A="
},
{
"name": "wiz_goal1",
"text": "The finish. I knew you would make it.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/rJcbZGCuFOwkCR30s3kr/xXexzk4ywgsZ5uaHLiW4/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=QV3gVBYYlSKiP11wWcZCSN2s0_U="
},
{
"name": "wiz_goal2",
"text": "There. Now go and boast about it.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/he81vQLBPpGHAqXvQgNe/kQC3kF3AO1saWO0uwG96/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=f38COQH2R7VDN8yxs-gL4iPIaRI="
},
{
"name": "knight_ask",
"text": "Ha! Race me to the flag, cyclist!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/JrLjd4i5QxDppSdErMeP/6BEAJVOZieYoqdaMwkGC/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=QW1I0y8oYCCpArp7C6MCYkMl-YQ="
},
{
"name": "knight_win",
"text": "By my sword... you are fast!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/QDqQy7L9KvtG7U5s4JUg/JAdsStmVYfIcetQUDWIV/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=l8YpQYUo5FboRtMk3OP5u_PtYQM="
},
{
"name": "knight_lose",
"text": "Too slow for the King!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/Lf7tTgbR8NO044BMn7qy/jLuRrvzJ1AIC6tvzbAHN/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=EgaB2fEZgpvda77bTRkb9NK-vlE="
},
{
"name": "oma_ask",
"text": "Think you can beat granny?",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/59xEr5gJJmicrpwUgIe0/VUF4XnGQ5GwXMqhnbjWG/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=QtvtsWKYtKs5ZPXA2XocZtIGuv0="
},
{
"name": "oma_win",
"text": "Oh my, what legs!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/aUzAUOvP8pHEnV5tBt45/wlvDB8w9cUBYE6OGEzGC/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=LUlQtXt_c0B0T5kkbSUeEpPb7Wg="
},
{
"name": "oma_lose",
"text": "Hah! Granny wins again!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/izXRUf59yI2XhXxs1fjm/AHgSwxLGOQIUPFhEqfyk/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=MimG1jgLuP8nWlulkbtbKsmDZ30="
},
{
"name": "gull_ask",
"text": "Skraa! Catch me if you can!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/pSgQaTjVy52TJLhZpBPu/bHFSLQaLXvlNMBc464T1/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=xmV_zJ4BogwIUpfQ7kyPaapZP-o="
},
{
"name": "gull_win",
"text": "Fine. You win. I wasn't even trying.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/cCVhIfRnJ88A1tSM9D0X/4DqMc0DFgSqC1NHRs8JH/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=ac_EHkKqjjbhdrVvuxHn7nrMfoU="
},
{
"name": "gull_lose",
"text": "Skraa! Pedal harder, featherless!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/ZwzBJuze9yKnDBeZmxNL/5GHruCvd3pIYGevmuZT7/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=cr0D_clzVbJt5cJ1Og5LMxk7eL8="
},
{
"name": "eagle_ask",
"text": "The sky is mine. Prove me wrong!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/1tR5o7suwH64a2bEHNse/hVo3vN0Yla7c3QyVY2Ps/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=OHTZ59NSAZdUZ2M1_g1CDvbcgKg="
},
{
"name": "eagle_win",
"text": "Hmph. Lucky tailwind, I suppose.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/A1QeQji7yAjCMsgwoKk4/L9u14c65NX7AfUPCjCvh/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=b__Tm1BYuhXVssRU7BcHxHhEgTM="
},
{
"name": "eagle_lose",
"text": "Nobody outruns the eagle.",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/9o1hTf3W6qWftX6f0fus/48mtxKTjs4EfxIUlkPHB/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=hDcHnpa02uOL-7He3R4BrRCfY6U="
},
{
"name": "kid_ask",
"text": "Bet you can't beat me! Go go go!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/DzTosFiqoSFcz3WIis4H/5ghZmItcjo1vb3QTbRt5/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=oVB4VX1X0mSBWZ0soL58XivlJCE="
},
{
"name": "kid_win",
"text": "Nooo! Again! Again!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/gVJPAlSO8oS13IbQWbEy/uTnMX5vhdySi1DCnCvZi/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=w3JZc73T1v9KjZfFj6YZqvozMtc="
},
{
"name": "kid_lose",
"text": "I won! I won! You're so slow!",
"url": "https://elevenlabsusercontent.com/database/workspace/4d5aafc926024fd6a4d28e6c2c26362c/content_generation/K3cY2zFIG5FHUD3fp9No/mAYyIX811Q8tgqECznss/content.mp3?Expires=1794477600&KeyName=assets-cdn-key-1&Signature=Z0womjNwEnPoYwGE5tfrYNhXAAg="
}
]