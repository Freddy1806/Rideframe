<?xml version="1.0"?>
<!-- RIDEFRAME for Garmin watches (strength, run, ride, more sports).
     minApiLevel 5.0.0: glances for watch-apps need 4.0, Sports.mc uses Activity.SPORT_* / SUB_SPORT_* of API 4.1.6; fr265 / fr265s / fenix 7 Pro / 7X Pro run API 5.2.
     VERIFY: product ids in the SDK Manager device list (fr265, fr265s, fenix7xpro, fenix7pro). The id below is a random UUID; keep it once the app is published. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="d8fac19af0fd404889b4c2b8a1f75cf7" type="watch-app" name="@Strings.AppName" entry="RideframeApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
            <iq:product id="fenix7xpro"/>
            <iq:product id="fenix7pro"/>
            <iq:product id="fenix8solar47mm"/>
        </iq:products>
        <iq:permissions>
            <!-- makeWebRequest through Garmin Connect Mobile -->
            <iq:uses-permission id="Communications"/>
            <!-- heart rate (Sensor.enableSensorEvents) -->
            <iq:uses-permission id="Sensor"/>
            <!-- ActivityRecording: run / ride / more as Garmin activities, the optional native strength activity -->
            <iq:uses-permission id="Fit"/>
            <!-- GPS for outdoor recordings (Position.enableLocationEvents) -->
            <iq:uses-permission id="Positioning"/>
            <!-- 23.11.: the indoor trainer's power, cadence and target in the FIT file (Session.createField) -->
            <iq:uses-permission id="FitContributor"/>
            <!-- 23.11.: the indoor trainer (FTMS / Wahoo over Toybox.BluetoothLowEnergy, API 3.1.0) -->
            <iq:uses-permission id="BluetoothLowEnergy"/>
            <!-- 25.11.: Garmin's recovery values for the coach (Health.mc): resting HR and VO2max (UserProfile), body battery and
                 pulse ox history (SensorHistory). Complications are not allowed for a watch-app. -->
            <iq:uses-permission id="UserProfile"/>
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
